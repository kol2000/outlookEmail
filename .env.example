# =============================================================================
# Flask basic configuration
# =============================================================================

# Must be set! Use the following command to generate a random string:
#   python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here

# Login password (default: admin123, will be hashed and stored automatically after first startup)
# It is recommended to change the password to a strong password (at least 8 characters) through the web interface immediately after the first startup.
LOGIN_PASSWORD=admin123

# =============================================================================
# Application runtime
# =============================================================================
PORT=5000
HOST=0.0.0.0
FLASK_ENV=production

# Global log level: DEBUG / INFO / WARNING / ERROR / CRITICAL (default INFO)
# INFO logs outbound proxy details for mail retrieval, token refresh and automatic authorization; passwords are redacted.
# Set WARNING to hide proxy diagnostics and most INFO logs during batch refresh or production use.
# LOG_LEVEL=WARNING

# Database path
DATABASE_PATH=data/outlook_accounts.db

# IMAP timeout (seconds)
IMAP_TIMEOUT=45

# The overall mailing list acquisition timeout (seconds) can also be adjusted in the system settings
MAIL_FETCH_OVERALL_TIMEOUT=120

# =============================================================================
# Temporary mailbox service
# =============================================================================
GPTMAIL_BASE_URL=https://mail.chatgpt.org.uk
GPTMAIL_API_KEY=gpt-test

DUCKMAIL_BASE_URL=https://api.duckmail.sbs
DUCKMAIL_API_KEY=

# =============================================================================
# OAuth2 configuration (optional, leave it blank and use the default value)
# =============================================================================
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_REDIRECT_URI=http://localhost:8080

# =============================================================================
# Docker self-update (optional, only used during Docker deployment)
# =============================================================================
# After enabling, the host Docker socket needs to be mounted to the container:
#   - /var/run/docker.sock:/var/run/docker.sock
# DOCKER_UPDATE_ENABLED=true
# DOCKER_UPDATE_CONTAINER=outlook-mail
